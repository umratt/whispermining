#!/bin/bash
# İlk açılışta bir kez çalışır.
set -u
log() { echo "[firstboot] $*"; }

# 1) Kök bölümü flash belleğin tamamına büyüt (imaj ~6 GB, flash 16 GB+)
ROOT_DEV=$(findmnt -n -o SOURCE /)
DISK="/dev/$(lsblk -no PKNAME "$ROOT_DEV")"
PART_NUM=$(cat "/sys/class/block/$(basename "$ROOT_DEV")/partition")
log "kök bölüm $ROOT_DEV ($DISK bölüm $PART_NUM) büyütülüyor"
growpart "$DISK" "$PART_NUM" && resize2fs "$ROOT_DEV" || log "büyütme atlandı"

# 2) Her rig'in kendi makine kimliği ve SSH anahtarı olsun (imaj hepsinde aynı)
rm -f /etc/machine-id /var/lib/dbus/machine-id
systemd-machine-id-setup
rm -f /etc/ssh/ssh_host_*
ssh-keygen -A >/dev/null 2>&1 || true

# 3) Rig adını rig.conf'tan al
NAME=$(sed -n 's/^RIG_NAME=//p' /wmining/rig.conf 2>/dev/null | tr -d '\r' | tr -cd 'A-Za-z0-9-' | cut -c1-32)
if [ -n "$NAME" ]; then
  echo "$NAME" > /etc/hostname
  sed -i "s/^127.0.1.1 .*/127.0.1.1 $NAME/" /etc/hosts
  hostname "$NAME"
  log "hostname: $NAME"
fi

# 4) Destek için isteğe bağlı SSH: WMINING bölümüne authorized_keys konduysa anahtarla girişi aç
if [ -s /wmining/authorized_keys ]; then
  install -d -m 700 /root/.ssh
  tr -d "$(printf '\r')" < /wmining/authorized_keys > /root/.ssh/authorized_keys
  chmod 600 /root/.ssh/authorized_keys
  systemctl enable --now ssh.service && log "SSH açıldı (sadece anahtar)"
fi

mkdir -p /var/lib/wmining && touch /var/lib/wmining/firstboot-done
log "tamam"
